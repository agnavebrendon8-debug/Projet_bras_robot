<?xml version="1.0"?>
<robot name="dh_5dof_robot">

  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>

  <!-- Base du Robot -->
  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 1 : Axe Z standard (Conforme D-H Axe 1) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.45" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.04"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.40"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 2 : Basculement D-H orthogonal (Axe 2 pivotant sur X local) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/> <!-- Conforme D-H après torsion phi = pi/2 -->
    <limit lower="-3.1416" upper="3.1416" effort="0.45" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><cylinder length="0.20" radius="0.03"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.20"/></geometry>
    </collision>
    <inertial>
      <mass value="0.60"/>
      <origin xyz="0 0 0.10"/>
      <inertia ixx="0.0025" iyy="0.0025" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 3 : Pivotement parallèle à l'axe 2 (Conforme D-H Axe 3) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="1 0 0"/> <!-- Aligné sur l'axe X orthogonal de torsion -->
    <limit lower="-3.1416" upper="3.1416" effort="0.45" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.025"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 4 : Pivotement parallèle (Conforme D-H Axe 4) -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0.45" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.02"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.20"/>
      <origin xyz="0 0 0.025"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Joint 5 : Torsion finale axiale de l'outil (Conforme D-H Axe 5) -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <!-- Retour sur l'axe Z local de l'effecteur -->
    <limit lower="-3.1416" upper="3.1416" effort="0.45" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <origin xyz="0 0 0.005"/>
      <inertia ixx="0.00005" iyy="0.00005" izz="0.00005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
